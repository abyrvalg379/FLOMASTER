<Window x:Class="FLOMASTER.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FLOMASTER.Converters"
        Title="FLOMASTER v2.2" Height="500" Width="440" MinHeight="500" MaxHeight="900"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Topmost="{Binding TopMostEnabled}"
        AllowDrop="True" Closing="Window_Closing">

    <Window.Resources>
        <!-- System color overrides -->
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#383838"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#383838"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#E87D0D"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>

        <!-- Dynamic theme brushes -->
        <SolidColorBrush x:Key="BgBrush" Color="#161616"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#202020"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#E87D0D"/>
        <SolidColorBrush x:Key="TextBrush" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="DimBrush" Color="#858585"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#303030"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#55E87D0D"/>
        <SolidColorBrush x:Key="AccentPressBrush" Color="#77E87D0D"/>

        <!-- Converters -->
        <local:BoolToVisibilityConverter x:Key="BoolToVis"/>

        <!-- ComboBox style for string items -->
        <Style TargetType="ComboBox" x:Key="DarkComboStringStyle">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}"
                                          BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="4" Padding="8,4">
                                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <TextBlock Text="{Binding SelectedItem, RelativeSource={RelativeSource TemplatedParent}}"
                                           Foreground="{DynamicResource TextBrush}" FontSize="13"/>
                            </ToggleButton>
                            <Popup Name="Popup" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"
                                   Placement="Bottom" VerticalOffset="2">
                                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="4">
                                    <ListBox Name="ListBox" ItemsSource="{Binding Items, RelativeSource={RelativeSource TemplatedParent}}"
                                             SelectedItem="{Binding SelectedItem, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                             Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0" Margin="2">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border Name="Bd" Background="{TemplateBinding Background}" Padding="6,5" CornerRadius="3">
                                                                <ContentPresenter/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                                </Trigger>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                    </ListBox>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox style with custom template -->
        <Style TargetType="ComboBox" x:Key="DarkComboStyle">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}"
                                          BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="4" Padding="8,4">
                                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <TextBlock Text="{Binding SelectedItem.Name, RelativeSource={RelativeSource TemplatedParent}}"
                                           Foreground="{DynamicResource TextBrush}" FontSize="13"/>
                            </ToggleButton>
                            <Popup Name="Popup" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"
                                   Placement="Bottom" VerticalOffset="2">
                                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="4">
                                    <ListBox Name="ListBox" ItemsSource="{Binding Items, RelativeSource={RelativeSource TemplatedParent}}"
                                             SelectedItem="{Binding SelectedItem, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                             Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0" Margin="2">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" Padding="6,4"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border Name="Bd" Background="{TemplateBinding Background}" Padding="6,5" CornerRadius="3">
                                                                <ContentPresenter/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                                </Trigger>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                    </ListBox>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle style -->
        <Style x:Key="ToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource DimBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Name="Bd" Background="Transparent" Padding="4,2" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentPressBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Checkbox style (themed) -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border Name="Box" Width="16" Height="16" CornerRadius="3"
                                    Background="{DynamicResource BgBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" VerticalAlignment="Center">
                                <Path Name="Check" Data="M 2,6 L 5,9 L 10,2" Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="2"
                                      Stretch="Uniform" Margin="2" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Scrollbar page button (transparent track) -->
        <Style x:Key="ScrollBarPageButtonStyle" TargetType="RepeatButton">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Rectangle Fill="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Scrollbar style (themed, rounded thumb) -->
        <Style TargetType="ScrollBar">
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="10"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageUpCommand"
                                                          Style="{StaticResource ScrollBarPageButtonStyle}"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb MinHeight="18">
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border x:Name="ThumbBd" Background="{DynamicResource BorderBrush}"
                                                                CornerRadius="5" Margin="1,1"/>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ThumbBd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                            </Trigger>
                                                            <Trigger Property="IsDragging" Value="True">
                                                                <Setter TargetName="ThumbBd" Property="Background" Value="{DynamicResource AccentPressBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageDownCommand"
                                                          Style="{StaticResource ScrollBarPageButtonStyle}"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Button style -->
        <Style TargetType="Button" x:Key="BtnStyle">
            <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="10,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Launch button style -->
        <Style TargetType="Button" x:Key="BtnLaunchStyle">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="10,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentDarkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource PanelBrush}" Padding="20,14">
            <Grid>
                <StackPanel>
                    <TextBlock Text="FLOMASTER" Foreground="{DynamicResource AccentBrush}" FontSize="22" FontWeight="Bold"
                               HorizontalAlignment="Left" FontFamily="Segoe UI"/>
                    <TextBlock Foreground="{DynamicResource DimBrush}" FontSize="11" Margin="0,2,0,0" FontFamily="Segoe UI">
                        <Run Text="OCIO Launcher"/>
                        <Run Text="  v2.2" Foreground="{DynamicResource AccentBrush}"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Accent line -->
        <Rectangle Grid.Row="1" Height="2" Fill="{DynamicResource AccentBrush}"/>

        <!-- Content -->
        <StackPanel Grid.Row="2" Margin="20,14,20,0">
            <!-- Application -->
            <TextBlock Text="APPLICATION" Foreground="{DynamicResource DimBrush}" FontSize="10" FontWeight="SemiBold"
                       Margin="0,0,0,6" FontFamily="Segoe UI"/>
            <ComboBox Name="AppCombo" DisplayMemberPath="Name" Margin="0,0,0,12"
                      Style="{StaticResource DarkComboStyle}"
                      ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"/>

            <!-- OCIO Config -->
            <TextBlock Text="OCIO CONFIG" Foreground="{DynamicResource DimBrush}" FontSize="10" FontWeight="SemiBold"
                       Margin="0,0,0,6" FontFamily="Segoe UI"/>
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" Name="OcioCombo" DisplayMemberPath="Name" Margin="0,0,4,0"
                          Style="{StaticResource DarkComboStyle}"
                          ItemsSource="{Binding OcioConfigs}" SelectedItem="{Binding SelectedOcio}"/>
                <Button Grid.Column="1" Content="+" Style="{StaticResource BtnStyle}" Width="30" Margin="0,0,2,0"
                        Command="{Binding AddOcioCommand}"/>
                <Button Grid.Column="2" Content="-" Style="{StaticResource BtnStyle}" Width="30"
                        Command="{Binding RemoveOcioCommand}"/>
            </Grid>

            <!-- Buttons -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Add" Style="{StaticResource BtnStyle}" Margin="0,0,3,0" Width="48"
                        Command="{Binding AddPresetCommand}"/>
                <Button Grid.Column="1" Content="Scan" Style="{StaticResource BtnStyle}" Margin="0,0,3,0" Width="50"
                        Command="{Binding RescanCommand}"/>
                <Button Grid.Column="2" Name="LogBtn" Content="Log" Style="{StaticResource BtnStyle}" Margin="0,0,3,0" Width="45"
                        Command="{Binding ViewLogCommand}"/>
                <Button Grid.Column="4" Content="Launch" Style="{StaticResource BtnLaunchStyle}" Width="90"
                        Command="{Binding LaunchCommand}"/>
            </Grid>

            <!-- Recent files toggle -->
            <Grid Margin="0,8,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ToggleButton Grid.Row="0" Style="{StaticResource ToggleStyle}"
                              Cursor="Hand" HorizontalAlignment="Left"
                              IsChecked="{Binding RecentPanelVisible}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x25B6;" FontSize="10" Foreground="{DynamicResource DimBrush}" Margin="0,0,6,0"/>
                        <TextBlock Text="Recent files" FontSize="11" Foreground="{DynamicResource DimBrush}"/>
                    </StackPanel>
                </ToggleButton>
                <StackPanel Grid.Row="1" Visibility="{Binding RecentPanelVisible, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0">
                    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="6">
                        <StackPanel>
                            <Button Content="Clear" Style="{StaticResource BtnStyle}" Width="50" Height="22" FontSize="10"
                                    Command="{Binding ClearRecentCommand}" HorizontalAlignment="Right" Margin="0,0,0,4"/>
                            <ListBox ItemsSource="{Binding RecentFiles}" MaxHeight="150"
                                     Background="Transparent" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="{DynamicResource TextBrush}" FontSize="11"
                                                   Cursor="Hand" Padding="2,1"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Quick commands toggle -->
            <Grid Margin="0,4,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ToggleButton Grid.Row="0" Style="{StaticResource ToggleStyle}"
                              Cursor="Hand" HorizontalAlignment="Left"
                              IsChecked="{Binding ArgsPanelVisible}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x25B6;" FontSize="10" Foreground="{DynamicResource DimBrush}" Margin="0,0,6,0"/>
                        <TextBlock Text="Quick commands" FontSize="11" Foreground="{DynamicResource DimBrush}"/>
                    </StackPanel>
                </ToggleButton>
                <StackPanel Grid.Row="1" Visibility="{Binding ArgsPanelVisible, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0">
                    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="6">
                        <ListBox Name="QuickCommandsList" ItemsSource="{Binding QuickCommands}" MaxHeight="150"
                                 Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Desc}" Foreground="{DynamicResource TextBrush}" FontSize="11"
                                               Cursor="Hand" Padding="2,1"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Arguments -->
            <TextBlock Text="ARGUMENTS" Foreground="{DynamicResource DimBrush}" FontSize="10" FontWeight="SemiBold"
                       Margin="0,8,0,4" FontFamily="Segoe UI"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Margin="0,0,4,0"
                         Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}"
                         BorderBrush="{DynamicResource BorderBrush}" FontSize="11" Height="24" Padding="6,2"
                         Text="{Binding ArgsText, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Grid.Column="1" Content="x" Style="{StaticResource BtnStyle}" Width="30" Height="24"
                        Command="{Binding ClearArgsCommand}"/>
            </Grid>

            <!-- Settings toggle -->
            <Grid Margin="0,8,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ToggleButton Grid.Row="0" Style="{StaticResource ToggleStyle}"
                              Cursor="Hand" HorizontalAlignment="Left"
                              IsChecked="{Binding SettingsPanelVisible}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x25B6;" FontSize="10" Foreground="{DynamicResource DimBrush}" Margin="0,0,6,0"/>
                        <TextBlock Text="Settings" FontSize="11" Foreground="{DynamicResource DimBrush}"/>
                    </StackPanel>
                </ToggleButton>
                <StackPanel Grid.Row="1" Visibility="{Binding SettingsPanelVisible, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0">
                    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="0,8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="200">
                            <StackPanel>
                                <TextBlock Text="THEME" Foreground="{DynamicResource DimBrush}" FontSize="10" FontWeight="SemiBold"
                                           Margin="10,0,10,4"/>
                                <ComboBox Name="ThemeCombo" Height="28" FontSize="12"
                                          Margin="0,0,0,12" Style="{StaticResource DarkComboStringStyle}"
                                          ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}"/>

                                <CheckBox Content="Start with Windows" Foreground="{DynamicResource TextBrush}"
                                          FontSize="12" Margin="10,0,10,4" IsChecked="{Binding AutoStartEnabled}"/>
                                <TextBlock Text="FLOMASTER will start minimized to tray" Foreground="{DynamicResource DimBrush}"
                                           FontSize="10" Margin="30,0,10,8"/>
                                <CheckBox Content="Always on top" Foreground="{DynamicResource TextBrush}"
                                          FontSize="12" Margin="10,0,10,4" IsChecked="{Binding TopMostEnabled}"/>
                                <CheckBox Content="Smooth animation" Foreground="{DynamicResource TextBrush}"
                                          FontSize="12" Margin="10,0,10,12" IsChecked="{Binding AnimationEnabled}"/>
                                <TextBlock Text="DEFAULT OCIO" Foreground="{DynamicResource DimBrush}" FontSize="10" FontWeight="SemiBold"
                                           Margin="10,0,10,4"/>
                                <TextBlock Text="Used when launching from tray" Foreground="{DynamicResource DimBrush}"
                                           FontSize="10" Margin="10,0,10,4"/>
                                <ComboBox DisplayMemberPath="Name" Margin="0,0,0,12"
                                          Style="{StaticResource DarkComboStyle}" Height="26"
                                          ItemsSource="{Binding OcioConfigs}" SelectedItem="{Binding DefaultOcio}"/>
                                <TextBlock Text="SCAN PATHS" Foreground="{DynamicResource DimBrush}" FontSize="10" FontWeight="SemiBold"
                                           Margin="10,0,10,4"/>
                                <TextBlock Text="Custom folders for DCC auto-scan" Foreground="{DynamicResource DimBrush}"
                                           FontSize="10" Margin="10,0,10,4"/>
                                <Grid Margin="10,0,10,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Add scan path" Style="{StaticResource BtnStyle}"
                                            Margin="0,0,4,0" Height="26" Command="{Binding AddScanPathCommand}"/>
                                    <Button Grid.Column="1" Content="Rescan" Style="{StaticResource BtnStyle}"
                                            Width="60" Height="26" Command="{Binding RescanCommand}"/>
                                </Grid>
                                <TextBlock Text="SHORTCUTS" Foreground="{DynamicResource DimBrush}" FontSize="10" FontWeight="SemiBold"
                                           Margin="10,0,10,6"/>
                                <Grid Margin="10,0,10,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="App shortcut" Style="{StaticResource BtnStyle}"
                                            Margin="0,0,4,0" Height="28" Command="{Binding CreateShortcutCommand}"/>
                                    <Button Grid.Column="1" Content="Desktop shortcut" Style="{StaticResource BtnStyle}"
                                            Margin="4,0,0,0" Height="28" Command="{Binding CreateDesktopShortcutCommand}"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- Status bar -->
        <Border Grid.Row="4" Background="{DynamicResource PanelBrush}" Padding="20,6" Margin="0,14,0,0">
            <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource DimBrush}" FontSize="11" FontFamily="Segoe UI"/>
        </Border>
    </Grid>
</Window>
