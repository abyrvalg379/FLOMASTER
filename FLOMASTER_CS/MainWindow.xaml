<Window x:Class="FLOMASTER.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FLOMASTER.Converters"
        Title="FLOMASTER v2.4.2" Height="560" Width="440" MinHeight="560" MaxHeight="940"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="{Binding TopMostEnabled}"
        AllowDrop="True" Closing="Window_Closing">
    <WindowChrome.WindowChrome>
        <!-- Собственная шапка в теме: перетаскивание есть, системной белой рамки нет.
             ResizeBorderThickness=0: окно нересайзится (CanMinimize), макимизации нет. -->
        <WindowChrome CaptionHeight="32" GlassFrameThickness="0" CornerRadius="0"
                      ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Кисти темы и скроллбар переехали в App.xaml (уровень приложения),
             чтобы пикер и служебные окна наследовали тему автоматически -->

        <!-- Converters -->
        <local:BoolToVisibilityConverter x:Key="BoolToVis"/>

        <!-- ComboBox style for string items -->
        <Style TargetType="ComboBox" x:Key="DarkComboStringStyle">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}"
                                          BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="4" Padding="8,4">
                                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <TextBlock Text="{Binding SelectedItem, RelativeSource={RelativeSource TemplatedParent}}"
                                           Foreground="{DynamicResource TextBrush}" FontSize="13"/>
                            </ToggleButton>
                            <Popup Name="Popup" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"
                                   Placement="Bottom" VerticalOffset="2">
                                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="4"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ListBox Name="ListBox" ItemsSource="{Binding Items, RelativeSource={RelativeSource TemplatedParent}}"
                                             SelectedItem="{Binding SelectedItem, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                             Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0" Margin="2"
                                             MaxHeight="260" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border Name="Bd" Background="{TemplateBinding Background}" Padding="6,5" CornerRadius="3">
                                                                <ContentPresenter/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                                </Trigger>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                    </ListBox>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox style with custom template -->
        <Style TargetType="ComboBox" x:Key="DarkComboStyle">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}"
                                          BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="4" Padding="8,4">
                                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <TextBlock Text="{Binding SelectedItem.Name, RelativeSource={RelativeSource TemplatedParent}}"
                                           Foreground="{DynamicResource TextBrush}" FontSize="13"/>
                            </ToggleButton>
                            <Popup Name="Popup" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"
                                   Placement="Bottom" VerticalOffset="2">
                                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="4"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ListBox Name="ListBox" ItemsSource="{Binding Items, RelativeSource={RelativeSource TemplatedParent}}"
                                             SelectedItem="{Binding SelectedItem, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                             Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0" Margin="2"
                                             MaxHeight="260" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" Padding="6,4"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border Name="Bd" Background="{TemplateBinding Background}" Padding="6,5" CornerRadius="3">
                                                                <ContentPresenter/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                                </Trigger>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                    </ListBox>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle style -->
        <Style x:Key="ToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource DimBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Name="Bd" Background="Transparent" Padding="4,2" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Checkbox style (themed) -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border Name="Box" Width="16" Height="16" CornerRadius="3"
                                    Background="{DynamicResource BgBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" VerticalAlignment="Center">
                                <Path Name="Check" Data="M 2,6 L 5,9 L 10,2" Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="2"
                                      Stretch="Uniform" Margin="2" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Скроллбар переехал в App.xaml (уровень приложения) -->

        <!-- Launch button style -->
        <Style TargetType="Button" x:Key="BtnLaunchStyle">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="10,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentDarkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" CornerRadius="10" Background="{DynamicResource PanelBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Собственная шапка окна (в теме): перетаскивание, свернуть, закрыть -->
        <Grid Grid.Row="0" Background="{DynamicResource PanelBrush}">
            <TextBlock Text="FLOMASTER" Foreground="{DynamicResource DimBrush}" FontSize="10"
                       VerticalAlignment="Center" Margin="12,0,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Content="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                        ToolTip="Minimize" Click="CaptionMinimize_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Width" Value="46"/>
                            <Setter Property="Height" Value="32"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                        ToolTip="Close" Click="CaptionClose_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Width" Value="46"/>
                            <Setter Property="Height" Value="32"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource CloseHoverBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Header -->
        <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" Padding="20,14">
            <Grid>
                <StackPanel>
                    <TextBlock Text="FLOMASTER" Foreground="{DynamicResource AccentBrush}" FontSize="22" FontWeight="Bold"
                               HorizontalAlignment="Left" FontFamily="Segoe UI"/>
                    <TextBlock Foreground="{DynamicResource DimBrush}" FontSize="11" Margin="0,2,0,0" FontFamily="Segoe UI">
                        <Run Text="OCIO Launcher"/>
                        <Run Text=" " />
                        <Run Text="{Binding VersionLabel, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Accent line -->
        <Rectangle Grid.Row="2" Height="2" Fill="{DynamicResource AccentBrush}"/>

        <!-- Content -->
        <StackPanel Grid.Row="3" Margin="20,14,20,0">
            <!-- Application -->
            <TextBlock Text="APPLICATION" Foreground="{DynamicResource DimBrush}" FontSize="10" FontWeight="SemiBold"
                       Margin="0,0,0,6" FontFamily="Segoe UI"/>
            <ComboBox Name="AppCombo" DisplayMemberPath="Name" Margin="0,0,0,12"
                      Style="{StaticResource DarkComboStyle}"
                      ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"/>

            <!-- OCIO Config -->
            <TextBlock Text="OCIO CONFIG" Foreground="{DynamicResource DimBrush}" FontSize="10" FontWeight="SemiBold"
                       Margin="0,0,0,6" FontFamily="Segoe UI"/>
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" Name="OcioCombo" DisplayMemberPath="Name" Margin="0,0,4,0"
                          Style="{StaticResource DarkComboStyle}"
                          ItemsSource="{Binding OcioConfigs}" SelectedItem="{Binding SelectedOcio}"/>
                <Button Grid.Column="1" Content="+" Style="{StaticResource BtnStyle}" Width="30" Margin="0,0,2,0"
                        Command="{Binding AddOcioCommand}"/>
                <Button Grid.Column="2" Content="-" Style="{StaticResource BtnStyle}" Width="30"
                        Command="{Binding RemoveOcioCommand}"/>
            </Grid>
            <!-- предупреждения валидатора конфига (пустое = не занимает места) -->
            <TextBlock FontSize="10" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,0,0,10">
                <Run Text="{Binding OcioWarningsText, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}"/>
            </TextBlock>

            <!-- Buttons -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Add" Style="{StaticResource BtnStyle}" Margin="0,0,3,0" Width="48"
                        Command="{Binding AddPresetCommand}"/>
                <Button Grid.Column="1" Content="Scan" Style="{StaticResource BtnStyle}" Margin="0,0,3,0" Width="50"
                        Command="{Binding RescanCommand}"/>
                <Button Grid.Column="2" Name="LogBtn" Content="Log" Style="{StaticResource BtnStyle}" Margin="0,0,3,0" Width="45"
                        Command="{Binding ViewLogCommand}"/>
                <Button Grid.Column="5" Content="Launch" Style="{StaticResource BtnLaunchStyle}" Width="90"
                        Command="{Binding LaunchCommand}"/>
            </Grid>

            </StackPanel>

            <!-- Панели: скролл, когда раскрыто слишком много; ARGUMENTS всегда видна снизу -->
            <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
            <StackPanel>

            <!-- Roles toggle (первая в стеке по решению юзера) -->
            <Grid Margin="0,8,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ToggleButton Grid.Row="0" Style="{StaticResource ToggleStyle}"
                              Cursor="Hand" HorizontalAlignment="Left"
                              IsChecked="{Binding RolesPanelVisible}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x25B6;" FontSize="10" Margin="0,0,6,0"/>
                        <TextBlock Text="Roles" FontSize="11"/>
                    </StackPanel>
                </ToggleButton>
                <StackPanel Grid.Row="1" Visibility="{Binding RolesPanelVisible, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0">
                    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="8">
                        <StackPanel>
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="LAUNCH OVERRIDES" Foreground="{DynamicResource DimBrush}" FontSize="10"
                                           FontWeight="SemiBold" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="Reset" Style="{StaticResource BtnStyle}" Width="48" Height="18" FontSize="9"
                                        Command="{Binding ResetRolesCommand}"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding OcioRoleRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="0,1" Style="{StaticResource BtnStyle}" Height="22"
                                                HorizontalContentAlignment="Left" Click="RolePick_Click" Tag="{Binding}">
                                            <TextBlock Text="{Binding DisplayText}" FontSize="10" FontFamily="Consolas"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock FontSize="9" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,4,0,0">
                                <Run Text="{Binding OcioOverrideWarnings, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Profiles toggle -->
            <Grid Margin="0,8,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ToggleButton Grid.Row="0" Style="{StaticResource ToggleStyle}"
                              Cursor="Hand" HorizontalAlignment="Left"
                              IsChecked="{Binding ProfilesPanelVisible}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x25B6;" FontSize="10" Margin="0,0,6,0"/>
                        <TextBlock Text="Profiles" FontSize="11"/>
                    </StackPanel>
                </ToggleButton>
                <StackPanel Grid.Row="1" Visibility="{Binding ProfilesPanelVisible, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0">
                    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="6">
                        <StackPanel>
                            <TextBlock Text="Snapshot of app + OCIO + arguments. Click a profile to apply."
                                       Foreground="{DynamicResource DimBrush}" FontSize="9" Margin="2,0,0,4"/>
                            <ItemsControl ItemsSource="{Binding Profiles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Style="{StaticResource BtnStyle}" Height="24"
                                                    HorizontalContentAlignment="Left" Padding="8,0"
                                                    Command="{Binding DataContext.ApplyProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}"
                                                               FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding PresetName, StringFormat=' · {0}'}" Foreground="{DynamicResource DimBrush}"
                                                               FontSize="10" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                    <TextBlock Text="{Binding OcioName, StringFormat=' · {0}'}" Foreground="{DynamicResource DimBrush}"
                                                               FontSize="10" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Column="1" Content="&#xD7;" Style="{StaticResource BtnStyle}" Width="24" Height="24"
                                                    Margin="3,0,0,0" FontSize="11"
                                                    Command="{Binding DataContext.DeleteProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Save current as profile" Style="{StaticResource BtnStyle}" Height="26" FontSize="11"
                                    Margin="0,4,0,0" Command="{Binding SaveProfileCommand}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Projects panel (встроена в окно по решению юзера: привязка, тема, hover — как у всех панелей) -->
            <Grid Margin="0,8,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ToggleButton Grid.Row="0" Style="{StaticResource ToggleStyle}"
                              Cursor="Hand" HorizontalAlignment="Left"
                              IsChecked="{Binding ProjectsPanelVisible}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x25B6;" FontSize="10" Margin="0,0,6,0"/>
                        <TextBlock Text="Projects" FontSize="11"/>
                    </StackPanel>
                </ToggleButton>
                <StackPanel Grid.Row="1" Visibility="{Binding ProjectsPanelVisible, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0">
                    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="6">
                        <StackPanel>
                            <TextBox Margin="0,0,0,4"
                                     Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}" FontSize="11" Height="24" Padding="6,2"
                                     Text="{Binding BrowserSearchText, UpdateSourceTrigger=PropertyChanged}"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" Style="{StaticResource DarkComboStringStyle}" Height="26" FontSize="11" Margin="0,0,4,0"
                                          ItemsSource="{Binding ProjectRoots}" SelectedItem="{Binding SelectedBrowserRoot}"/>
                                <Button Grid.Column="1" Content="+" Style="{StaticResource BtnStyle}" Width="30" Height="26" Margin="0,0,2,0"
                                        ToolTip="Add project folder" Command="{Binding AddProjectRootCommand}"/>
                                <Button Grid.Column="2" Content="-" Style="{StaticResource BtnStyle}" Width="30" Height="26"
                                        ToolTip="Remove selected folder"
                                        Command="{Binding RemoveProjectRootCommand}"
                                        CommandParameter="{Binding SelectedBrowserRoot, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </Grid>
                            <ListBox ItemsSource="{Binding BrowserFiles}" MaxHeight="150"
                                     Background="Transparent" BorderThickness="0" Margin="0,4,0,0"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource BtnStyle}" Height="22" Margin="0,1"
                                                HorizontalContentAlignment="Left" Padding="8,0"
                                                Command="{Binding DataContext.OpenProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding FullPath}" ToolTip="{Binding FullPath}">
                                            <TextBlock Text="{Binding RelPath}" FontSize="10" FontFamily="Consolas"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Button>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Recent files toggle -->
            <Grid Margin="0,8,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ToggleButton Grid.Row="0" Style="{StaticResource ToggleStyle}"
                              Cursor="Hand" HorizontalAlignment="Left"
                              IsChecked="{Binding RecentPanelVisible}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x25B6;" FontSize="10" Margin="0,0,6,0"/>
                        <TextBlock Text="Recent files" FontSize="11"/>
                    </StackPanel>
                </ToggleButton>
                <StackPanel Grid.Row="1" Visibility="{Binding RecentPanelVisible, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0">
                    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="6">
                        <StackPanel>
                            <Button Content="Clear" Style="{StaticResource BtnStyle}" Width="50" Height="22" FontSize="10"
                                    Command="{Binding ClearRecentCommand}" HorizontalAlignment="Right" Margin="0,0,0,4"/>
                            <ListBox Name="RecentList" ItemsSource="{Binding RecentFiles}" MaxHeight="150"
                                     Background="Transparent" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="{DynamicResource TextBrush}" FontSize="11"
                                                   Cursor="Hand" Padding="2,1"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Settings toggle -->
            <Grid Margin="0,8,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ToggleButton Grid.Row="0" Style="{StaticResource ToggleStyle}"
                              Cursor="Hand" HorizontalAlignment="Left"
                              IsChecked="{Binding SettingsPanelVisible}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x25B6;" FontSize="10" Margin="0,0,6,0"/>
                        <TextBlock Text="Settings" FontSize="11"/>
                    </StackPanel>
                </ToggleButton>
                <StackPanel Grid.Row="1" Visibility="{Binding SettingsPanelVisible, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0">
                    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="0,8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="200">
                            <StackPanel>
                                <TextBlock Text="UPDATES" Foreground="{DynamicResource DimBrush}" FontSize="10" FontWeight="SemiBold"
                                           Margin="10,0,10,4"/>
                                <CheckBox Content="Check for updates on start" Foreground="{DynamicResource TextBrush}"
                                          FontSize="12" Margin="10,0,10,4" IsChecked="{Binding CheckUpdatesEnabled}"/>
                                <StackPanel Orientation="Horizontal" Margin="10,0,10,12"
                                            Visibility="{Binding UpdateReady, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding UpdateInfoText}" Foreground="{DynamicResource AccentBrush}"
                                               FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Button Content="Restart and install" Style="{StaticResource BtnStyle}" Width="130" Height="22"
                                            FontSize="10" Command="{Binding UpdateCommand}"/>
                                </StackPanel>

                                <TextBlock Text="THEME" Foreground="{DynamicResource DimBrush}" FontSize="10" FontWeight="SemiBold"
                                           Margin="10,0,10,4"/>
                                <ComboBox Name="ThemeCombo" Height="28" FontSize="12"
                                          Margin="0,0,0,12" Style="{StaticResource DarkComboStringStyle}"
                                          ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}"/>

                                <CheckBox Content="Start with Windows" Foreground="{DynamicResource TextBrush}"
                                          FontSize="12" Margin="10,0,10,4" IsChecked="{Binding AutoStartEnabled}"/>
                                <TextBlock Text="FLOMASTER will start minimized to tray" Foreground="{DynamicResource DimBrush}"
                                           FontSize="10" Margin="30,0,10,8"/>
                                <CheckBox Content="Always on top" Foreground="{DynamicResource TextBrush}"
                                          FontSize="12" Margin="10,0,10,4" IsChecked="{Binding TopMostEnabled}"/>
                                <CheckBox Content="Smooth animation" Foreground="{DynamicResource TextBrush}"
                                          FontSize="12" Margin="10,0,10,4" IsChecked="{Binding AnimationEnabled}"/>
                                <CheckBox Content="Overlay on top (Ctrl+Alt+F)" Foreground="{DynamicResource TextBrush}"
                                          FontSize="12" Margin="0,0,0,4" IsChecked="{Binding OverlayTopmost}"/>
                                <CheckBox Content="Global hotkey (Ctrl+Alt+F)" Foreground="{DynamicResource TextBrush}"
                                          FontSize="12" Margin="10,0,10,12" IsChecked="{Binding HotkeyEnabled}"/>
                                <TextBlock Text="DEFAULT OCIO" Foreground="{DynamicResource DimBrush}" FontSize="10" FontWeight="SemiBold"
                                           Margin="10,0,10,4"/>
                                <TextBlock Text="Used when launching from tray" Foreground="{DynamicResource DimBrush}"
                                           FontSize="10" Margin="10,0,10,4"/>
                                <ComboBox DisplayMemberPath="Name" Margin="0,0,0,12"
                                          Style="{StaticResource DarkComboStyle}" Height="26"
                                          ItemsSource="{Binding OcioConfigs}" SelectedItem="{Binding DefaultOcio}"/>
                                <TextBlock Text="SCAN PATHS" Foreground="{DynamicResource DimBrush}" FontSize="10" FontWeight="SemiBold"
                                           Margin="10,0,10,4"/>
                                <TextBlock Text="Custom folders for DCC auto-scan" Foreground="{DynamicResource DimBrush}"
                                           FontSize="10" Margin="10,0,10,4"/>
                                <Grid Margin="10,0,10,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Add scan path" Style="{StaticResource BtnStyle}"
                                            Margin="0,0,4,0" Height="26" Command="{Binding AddScanPathCommand}"/>
                                    <Button Grid.Column="1" Content="Rescan" Style="{StaticResource BtnStyle}"
                                            Width="60" Height="26" Command="{Binding RescanCommand}"/>
                                </Grid>
                                <TextBlock Text="SYNC" Foreground="{DynamicResource DimBrush}" FontSize="10" FontWeight="SemiBold"
                                           Margin="10,0,10,4"/>
                                <TextBlock Text="Move profiles and roots to another machine" Foreground="{DynamicResource DimBrush}"
                                           FontSize="10" Margin="10,0,10,4"/>
                                <Grid Margin="10,0,10,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Export settings" Style="{StaticResource BtnStyle}"
                                            Margin="0,0,4,0" Height="26" Command="{Binding ExportSettingsCommand}"/>
                                    <Button Grid.Column="1" Content="Import settings" Style="{StaticResource BtnStyle}"
                                            Margin="4,0,0,0" Height="26" Command="{Binding ImportSettingsCommand}"/>
                                </Grid>
                                <TextBlock Text="SHORTCUTS" Foreground="{DynamicResource DimBrush}" FontSize="10" FontWeight="SemiBold"
                                           Margin="10,0,10,6"/>
                                <Grid Margin="10,0,10,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="App shortcut" Style="{StaticResource BtnStyle}"
                                            Margin="0,0,4,0" Height="28" Command="{Binding CreateShortcutCommand}"/>
                                    <Button Grid.Column="1" Content="Desktop shortcut" Style="{StaticResource BtnStyle}"
                                            Margin="4,0,0,0" Height="28" Command="{Binding CreateDesktopShortcutCommand}"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Quick commands toggle (в самом низу по решению юзера) -->
            <Grid Margin="0,4,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ToggleButton Grid.Row="0" Style="{StaticResource ToggleStyle}"
                              Cursor="Hand" HorizontalAlignment="Left"
                              IsChecked="{Binding ArgsPanelVisible}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x25B6;" FontSize="10" Margin="0,0,6,0"/>
                        <TextBlock Text="Quick commands" FontSize="11"/>
                    </StackPanel>
                </ToggleButton>
                <StackPanel Grid.Row="1" Visibility="{Binding ArgsPanelVisible, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0">
                    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="6">
                        <ListBox Name="QuickCommandsList" ItemsSource="{Binding QuickCommands}" MaxHeight="150"
                                 Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Desc}" Foreground="{DynamicResource TextBrush}" FontSize="11"
                                               Cursor="Hand" Padding="2,1"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </StackPanel>
            </Grid>

            </StackPanel>
            </ScrollViewer>

            <!-- Arguments (всегда видна) -->
            <TextBlock Grid.Row="5" Text="ARGUMENTS" Foreground="{DynamicResource DimBrush}" FontSize="10" FontWeight="SemiBold"
                       Margin="0,8,0,4" FontFamily="Segoe UI"/>
            <Grid Grid.Row="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Margin="0,0,4,0"
                         Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}"
                         BorderBrush="{DynamicResource BorderBrush}" FontSize="11" Height="24" Padding="6,2"
                         Text="{Binding ArgsText, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Grid.Column="1" Content="x" Style="{StaticResource BtnStyle}" Width="30" Height="24"
                        Command="{Binding ClearArgsCommand}"/>
            </Grid>

        <!-- Status bar -->
        <Border Grid.Row="6" Background="{DynamicResource PanelBrush}" Padding="20,6" Margin="0,14,0,0">
            <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource DimBrush}" FontSize="11" FontFamily="Segoe UI"/>
        </Border>
    </Grid>
    </Border>
</Window>
