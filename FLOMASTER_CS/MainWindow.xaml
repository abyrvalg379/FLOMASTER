<Window x:Class="FLOMASTER.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FLOMASTER v2.0" Height="500" Width="440" MinHeight="500" MaxHeight="900"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        AllowDrop="True"
        Background="{DynamicResource BgBrush}">

    <Window.Resources>
        <!-- Dynamic theme brushes -->
        <SolidColorBrush x:Key="BgBrush" Color="#303030"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#383838"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#E87D0D"/>
        <SolidColorBrush x:Key="TextBrush" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="DimBrush" Color="#999999"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#4A4A4A"/>

        <!-- System color overrides for ComboBox dropdowns -->
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#383838"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#383838"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#E87D0D"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>

        <!-- Button style -->
        <Style x:Key="BtnStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="10,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Launch button style -->
        <Style x:Key="BtnLaunchStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="10,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4a80b5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2a5080"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox item style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Padding" Value="6,4"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ScrollViewer style with rounded scrollbar -->
        <Style TargetType="ScrollViewer">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Track Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Name="ThumbBorder" Background="#555" CornerRadius="4" Margin="2,0"
                                                        BorderBrush="#666" BorderThickness="1"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle button style -->
        <Style x:Key="ToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource DimBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Name="Bd" Background="Transparent" Padding="4,2" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentPressBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ComboBox template -->
        <Style x:Key="DarkComboStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}"
                                          BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="4" Padding="8,4">
                                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <TextBlock Text="{Binding SelectedItem.Name, RelativeSource={RelativeSource TemplatedParent}}"
                                           Foreground="{DynamicResource TextBrush}" FontSize="13"/>
                            </ToggleButton>
                            <Popup Name="Popup" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"
                                   Placement="Bottom" VerticalOffset="2">
                                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="4">
                                    <ListBox Name="ListBox" ItemsSource="{Binding Items, RelativeSource={RelativeSource TemplatedParent}}"
                                             SelectedItem="{Binding SelectedItem, RelativeSource={RelativeSource TemplatedParent}}"
                                             Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" Padding="6,4"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border Name="Bd" Background="{TemplateBinding Background}" Padding="6,5">
                                                                <ContentPresenter/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                                </Trigger>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                    </ListBox>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Header -->
            <RowDefinition Height="Auto"/>   <!-- Accent line -->
            <RowDefinition Height="Auto"/>   <!-- Content -->
            <RowDefinition Height="*"/>      <!-- Spacer -->
            <RowDefinition Height="Auto"/>   <!-- Status -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource PanelBrush}" Padding="20,14">
            <Grid>
                <StackPanel>
                    <TextBlock Text="FLOMASTER" Foreground="{DynamicResource AccentBrush}" FontSize="22" FontWeight="Bold"
                               HorizontalAlignment="Left" FontFamily="Segoe UI"/>
                    <TextBlock Foreground="{DynamicResource DimBrush}" FontSize="11" Margin="0,2,0,0"
                               FontFamily="Segoe UI">
                        <Run Text="OCIO Launcher"/>
                        <Run Text="  v2.0" Foreground="{DynamicResource AccentBrush}"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Accent line -->
        <Rectangle Grid.Row="1" Height="2" Fill="{DynamicResource AccentBrush}"/>

        <!-- Content -->
        <StackPanel Grid.Row="2" Margin="20,14,20,0">
            <!-- Application -->
            <TextBlock Text="APPLICATION" Foreground="{DynamicResource DimBrush}" FontSize="10" FontWeight="SemiBold"
                       Margin="0,0,0,6" FontFamily="Segoe UI"/>
            <ComboBox Name="AppCombo" DisplayMemberPath="Name" Margin="0,0,0,12"
                      Style="{StaticResource DarkComboStyle}"/>

            <!-- OCIO Config -->
            <TextBlock Text="OCIO CONFIG" Foreground="{DynamicResource DimBrush}" FontSize="10" FontWeight="SemiBold"
                       Margin="0,0,0,6" FontFamily="Segoe UI"/>
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" Name="OcioCombo" DisplayMemberPath="Name" Margin="0,0,4,0"
                          Style="{StaticResource DarkComboStyle}"/>
                <Button Grid.Column="1" Name="AddOcioBtn" Content="+" Style="{StaticResource BtnStyle}" Width="30" Margin="0,0,2,0"/>
                <Button Grid.Column="2" Name="RemoveOcioBtn" Content="-" Style="{StaticResource BtnStyle}" Width="30"/>
            </Grid>

            <!-- Buttons -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Name="AddBtn" Content="Add" Style="{StaticResource BtnStyle}" Margin="0,0,3,0" Width="48"/>
                <Button Grid.Column="1" Name="RescanBtn" Content="Scan" Style="{StaticResource BtnStyle}" Margin="0,0,3,0" Width="50"/>
                <Button Grid.Column="2" Name="LogBtn" Content="Log" Style="{StaticResource BtnStyle}" Margin="0,0,3,0" Width="45"/>
                <Button Grid.Column="4" Name="LaunchBtn" Content="Launch" Style="{StaticResource BtnLaunchStyle}" Width="90"/>
            </Grid>

            <!-- Recent files toggle -->
            <Grid Margin="0,8,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ToggleButton Name="RecentToggle" Grid.Row="0" Style="{StaticResource ToggleStyle}"
                              Cursor="Hand" HorizontalAlignment="Left" Content="▶ Recent files"/>
                <StackPanel Name="RecentPanel" Grid.Row="1" Visibility="Collapsed" Margin="0,4,0,0">
                    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="6">
                        <StackPanel Name="RecentItems"/>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Quick commands toggle -->
            <Grid Margin="0,4,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ToggleButton Name="ArgsMenuToggle" Grid.Row="0" Style="{StaticResource ToggleStyle}"
                              Cursor="Hand" HorizontalAlignment="Left" Content="▶ Quick commands"/>
                <StackPanel Name="ArgsMenuPanel" Grid.Row="1" Visibility="Collapsed" Margin="0,4,0,0">
                    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="6">
                        <StackPanel Name="ArgsMenuItems"/>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Arguments -->
            <TextBlock Text="ARGUMENTS" Foreground="{DynamicResource DimBrush}" FontSize="10" FontWeight="SemiBold"
                       Margin="0,8,0,4" FontFamily="Segoe UI"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Name="ArgsBox" Margin="0,0,4,0"
                         Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}"
                         BorderBrush="{DynamicResource BorderBrush}" FontSize="11" Height="24" Padding="6,2"/>
                <Button Grid.Column="1" Name="ClearArgsBtn" Content="x" Style="{StaticResource BtnStyle}" Width="30" Height="24"/>
            </Grid>

            <!-- Settings toggle -->
            <Grid Margin="0,8,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ToggleButton Name="SettingsToggle" Grid.Row="0" Style="{StaticResource ToggleStyle}"
                              Cursor="Hand" HorizontalAlignment="Left" Content="▶ Settings"/>
                <StackPanel Name="SettingsPanel" Grid.Row="1" Visibility="Collapsed" Margin="0,4,0,0">
                    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="10,8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="200">
                            <StackPanel>
                            <TextBlock Text="THEME" Foreground="{DynamicResource DimBrush}" FontSize="10" FontWeight="SemiBold"
                                       Margin="0,0,0,4"/>
                            <ComboBox Name="ThemeCombo" DisplayMemberPath="Name" Height="28" FontSize="12"
                                      Margin="0,0,0,12" Style="{StaticResource DarkComboStyle}"/>

                            <CheckBox Name="AutoStartCheck" Content="Start with Windows" Foreground="{DynamicResource TextBrush}"
                                      FontSize="12" Margin="0,0,0,4"/>
                            <TextBlock Text="FLOMASTER will start minimized to tray" Foreground="{DynamicResource DimBrush}"
                                       FontSize="10" Margin="20,0,0,8"/>

                            <CheckBox Name="TopMostCheck" Content="Always on top" Foreground="{DynamicResource TextBrush}"
                                      FontSize="12" Margin="0,0,0,4"/>
                            <CheckBox Name="AnimationCheck" Content="Smooth animation" Foreground="{DynamicResource TextBrush}"
                                      FontSize="12" Margin="0,0,0,12"/>

                            <TextBlock Text="DEFAULT OCIO" Foreground="{DynamicResource DimBrush}" FontSize="10" FontWeight="SemiBold"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="Used when launching from tray" Foreground="{DynamicResource DimBrush}"
                                       FontSize="10" Margin="0,0,0,4"/>
                            <ComboBox Name="DefaultOcioCombo" DisplayMemberPath="Name" Margin="0,0,0,12"
                                      Style="{StaticResource DarkComboStyle}" Height="26"/>

                            <TextBlock Text="SCAN PATHS" Foreground="{DynamicResource DimBrush}" FontSize="10" FontWeight="SemiBold"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="Custom folders for DCC auto-scan" Foreground="{DynamicResource DimBrush}"
                                       FontSize="10" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Name="AddScanPathBtn" Content="Add scan path" Style="{StaticResource BtnStyle}"
                                        Margin="0,0,4,0" Height="26"/>
                                <Button Grid.Column="1" Name="RescanBtn2" Content="Rescan" Style="{StaticResource BtnStyle}"
                                        Width="60" Height="26"/>
                            </Grid>

                            <TextBlock Text="SHORTCUTS" Foreground="{DynamicResource DimBrush}" FontSize="10" FontWeight="SemiBold"
                                       Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Name="ShortcutBtn" Content="App shortcut" Style="{StaticResource BtnStyle}"
                                        Margin="0,0,4,0" Height="28" ToolTip="Shortcut for selected app with OCIO"/>
                                <Button Grid.Column="1" Name="DesktopBtn" Content="Desktop shortcut" Style="{StaticResource BtnStyle}"
                                        Margin="4,0,0,0" Height="28" ToolTip="FLOMASTER shortcut on desktop"/>
                            </Grid>
                        </StackPanel>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- Status bar -->
        <Border Grid.Row="4" Background="{DynamicResource PanelBrush}" Padding="20,6" Margin="0,14,0,0">
            <TextBlock Name="StatusText" Text="Drop .exe or .blend here" Foreground="{DynamicResource DimBrush}" FontSize="11"
                       FontFamily="Segoe UI"/>
        </Border>
    </Grid>
</Window>
