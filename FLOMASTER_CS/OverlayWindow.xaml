<Window x:Class="FLOMASTER.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FLOMASTER"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        WindowStartupLocation="Manual"
        Topmost="True"
        ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <SolidColorBrush x:Key="BrandRed" Color="#C82823"/>

        <!-- Плитка: иконка/монограмма слева + название -->
        <Style x:Key="TileButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="330"/>
            <Setter Property="Height" Value="132"/>
            <Setter Property="Margin" Value="0,0,20,20"/>
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="Bd" Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter Margin="18,0,14,0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentPressBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Строка последних файлов -->
        <Style x:Key="RecentButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="18,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Заголовок секции -->
        <Style x:Key="SectionLabelStyle" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="10,0,0,18"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Хиро: бренд по центру -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,64,0,40">
            <TextBlock HorizontalAlignment="Center" FontSize="54" FontWeight="Bold">
                <Run Text="FLOMASTER" Foreground="{DynamicResource AccentBrush}"/><Run Text="." Foreground="{StaticResource BrandRed}"/>
            </TextBlock>
            <TextBlock HorizontalAlignment="Center" Margin="0,10,0,0"
                       Foreground="{DynamicResource DimBrush}" FontSize="13">
                ЗАПУСТИТЕ ПРИЛОЖЕНИЕ В ЗАДАННОМ ЦВЕТОВОМ ПРОСТРАНСТВЕ
            </TextBlock>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid MaxWidth="1420" HorizontalAlignment="Center" VerticalAlignment="Top">
                <StackPanel>

                    <!-- ПРИЛОЖЕНИЯ -->
                    <StackPanel Style="{StaticResource SectionLabelStyle}">
                        <Rectangle Width="26" Height="3" Fill="{DynamicResource AccentBrush}"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Text="ПРИЛОЖЕНИЯ" Foreground="{DynamicResource TextBrush}"
                                   FontSize="15" FontWeight="SemiBold"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding AppTiles}" Margin="10,0,0,10">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource TileButtonStyle}" Click="Tile_Click" Tag="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{Binding Icon}" Width="44" Height="44"
                                               RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                                        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Subtitle}" FontSize="10.5"
                                                       Foreground="{DynamicResource DimBrush}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- ПРОФИЛИ -->
                    <StackPanel x:Name="ProfilesSection" Style="{StaticResource SectionLabelStyle}" Margin="10,14,0,18">
                        <Rectangle Width="26" Height="3" Fill="{DynamicResource AccentBrush}"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Text="ПРОФИЛИ" Foreground="{DynamicResource TextBrush}"
                                   FontSize="15" FontWeight="SemiBold"/>
                    </StackPanel>
                    <ItemsControl x:Name="ProfilesList" ItemsSource="{Binding ProfileTiles}" Margin="10,0,0,10">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource TileButtonStyle}" Height="112" Click="Tile_Click" Tag="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="44" Height="44" CornerRadius="22"
                                                Background="{DynamicResource AccentBrush}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Monogram}" FontSize="19" FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentTextBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Subtitle}" FontSize="10.5"
                                                       Foreground="{DynamicResource DimBrush}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- ПОСЛЕДНИЕ ФАЙЛЫ -->
                    <StackPanel x:Name="RecentSection" Style="{StaticResource SectionLabelStyle}" Margin="10,14,0,18">
                        <Rectangle Width="26" Height="3" Fill="{DynamicResource AccentBrush}"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Text="ПОСЛЕДНИЕ ФАЙЛЫ" Foreground="{DynamicResource TextBrush}"
                                   FontSize="15" FontWeight="SemiBold"/>
                    </StackPanel>
                    <ItemsControl x:Name="RecentList" ItemsSource="{Binding RecentTiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource RecentButtonStyle}" Click="Tile_Click" Tag="{Binding}"
                                        ToolTip="{Binding FullPath}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Badge}" FontSize="10.5"
                                                   FontFamily="Consolas" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,14,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12"
                                                   FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Dir}" FontSize="10.5"
                                                   Foreground="{DynamicResource DimBrush}"
                                                   VerticalAlignment="Center" Margin="24,0,0,0"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="RecentEmpty" Text="Открытые файлы появятся здесь."
                               Foreground="{DynamicResource DimBrush}" FontSize="12" FontStyle="Italic"
                               Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Футер -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,10,0,26"
                    Orientation="Horizontal">
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="4" Padding="10,4" Margin="0,0,8,0">
                <TextBlock Text="ESC" Foreground="{DynamicResource TextBrush}" FontSize="12"
                           FontFamily="Consolas"/>
            </Border>
            <TextBlock Text="закрыть" Foreground="{DynamicResource DimBrush}" FontSize="12"
                       VerticalAlignment="Center" Margin="0,0,18,0"/>
            <TextBlock Text="github.com/abyrvalg379/FLOMASTER" Foreground="{DynamicResource DimBrush}"
                       FontSize="11" VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
