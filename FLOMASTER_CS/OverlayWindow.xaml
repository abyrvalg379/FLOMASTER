<Window x:Class="FLOMASTER.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FLOMASTER"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        WindowStartupLocation="Manual"
        Topmost="True"
        ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <SolidColorBrush x:Key="BrandRed" Color="#C82823"/>
        <!-- Плитка приложения/профиля: панель + акцентная кромка слева -->
        <Style x:Key="TileButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="272"/>
            <Setter Property="Height" Value="104"/>
            <Setter Property="Margin" Value="0,0,16,16"/>
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <Grid>
                                <Rectangle Name="Edge" Width="4" HorizontalAlignment="Left"
                                           Fill="{DynamicResource BorderBrush}"/>
                                <ContentPresenter Margin="20,0,12,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                                <Setter TargetName="Edge" Property="Fill" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentPressBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Строка последних файлов -->
        <Style x:Key="RecentButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="14,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Заголовок секции: акцентный штрих + капс -->
        <Style x:Key="SectionLabelStyle" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="10,26,0,10"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка: фирменный заголовок + подсказка -->
        <Grid Grid.Row="0" Margin="36,28,36,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="FLOMASTER" Foreground="{DynamicResource AccentBrush}"
                           FontSize="40" FontWeight="Bold"/>
                <TextBlock Text="." Foreground="{StaticResource BrandRed}" FontSize="40" FontWeight="Bold" Margin="2,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="4" Padding="10,4" Margin="0,0,8,0">
                    <TextBlock Text="ESC" Foreground="{DynamicResource TextBrush}" FontSize="12"
                               FontFamily="Consolas"/>
                </Border>
                <TextBlock Text="закрыть" Foreground="{DynamicResource DimBrush}" FontSize="12"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Фирменная акцентная линия -->
        <Rectangle Grid.Row="1" Height="2" Fill="{DynamicResource AccentBrush}" Margin="36,0,36,0"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid MaxWidth="1660" HorizontalAlignment="Center" Margin="0,8,0,24">
                <StackPanel>

                    <!-- ПРИЛОЖЕНИЯ -->
                    <StackPanel Style="{StaticResource SectionLabelStyle}">
                        <Rectangle Width="22" Height="3" Fill="{DynamicResource AccentBrush}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="ПРИЛОЖЕНИЯ" Foreground="{DynamicResource TextBrush}"
                                   FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Presets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource TileButtonStyle}" Click="PresetTile_Click">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Exe}" FontSize="10"
                                                   Foreground="{DynamicResource DimBrush}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- ПРОФИЛИ -->
                    <StackPanel Style="{StaticResource SectionLabelStyle}">
                        <Rectangle Width="22" Height="3" Fill="{DynamicResource AccentBrush}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="ПРОФИЛИ" Foreground="{DynamicResource TextBrush}"
                                   FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Profiles}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource TileButtonStyle}" Height="88" Click="ProfileTile_Click">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding PresetName}" FontSize="10"
                                                   Foreground="{DynamicResource DimBrush}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="ProfilesEmpty" Text="Профилей пока нет — соберите связку «приложение + конфиг + аргументы» в панели Profiles лаунчера."
                               Foreground="{DynamicResource DimBrush}" FontSize="12" FontStyle="Italic"
                               Margin="10,0,0,0"/>

                    <!-- ПОСЛЕДНИЕ ФАЙЛЫ -->
                    <StackPanel Style="{StaticResource SectionLabelStyle}">
                        <Rectangle Width="22" Height="3" Fill="{DynamicResource AccentBrush}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="ПОСЛЕДНИЕ ФАЙЛЫ" Foreground="{DynamicResource TextBrush}"
                                   FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding RecentFiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource RecentButtonStyle}" Click="RecentTile_Click"
                                        ToolTip="{Binding}">
                                    <TextBlock Text="{Binding}" FontSize="11.5" FontFamily="Consolas"
                                               TextTrimming="CharacterEllipsis"/>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="RecentEmpty" Text="Открытые файлы появятся здесь."
                               Foreground="{DynamicResource DimBrush}" FontSize="12" FontStyle="Italic"
                               Margin="10,0,0,0"/>

                    <!-- Подвал -->
                    <TextBlock Text="github.com/abyrvalg379/FLOMASTER" Foreground="{DynamicResource DimBrush}"
                               FontSize="10" Margin="10,30,0,0"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
