<Window x:Class="FLOMASTER.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FLOMASTER"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Topmost="{Binding OverlayTopmost}"
        Background="{DynamicResource BgBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="96" GlassFrameThickness="0" CornerRadius="0"
                      ResizeBorderThickness="6" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="BrandRed" Color="#C82823"/>

        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TileButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="118"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="Bd" Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter Margin="18,0,14,0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentPressBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChipButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="Bd" Background="{TemplateBinding Background}" CornerRadius="19"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChipSelectedStyle" TargetType="Button" BasedOn="{StaticResource ChipButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="RowButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="14,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionLabelStyle" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Grid Grid.Row="0" Margin="36,22,12,14">
            <StackPanel>
                <TextBlock FontSize="38" FontWeight="Bold">
                    <Run Text="FLOMASTER" Foreground="{DynamicResource AccentBrush}"/><Run Text="." Foreground="{StaticResource BrandRed}"/>
                </TextBlock>
                <TextBlock Text="LAUNCH APPLICATIONS IN THE ASSIGNED COLOR SPACE"
                           Foreground="{DynamicResource DimBrush}" FontSize="11.5" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource CaptionButtonStyle}" Content="&#xE921;"
                        ToolTip="Minimize" Click="CaptionMinimize_Click"/>
                <Button Style="{StaticResource CaptionButtonStyle}" Content="&#xE923;"
                        ToolTip="Maximize/Restore" Click="CaptionMaximize_Click"/>
                <Button Style="{StaticResource CaptionButtonStyle}" Content="&#xE8BB;"
                        ToolTip="Close" Click="CaptionClose_Click"/>
            </StackPanel>
        </Grid>

        <!-- Поиск: фиксированная позиция, не двигается при фильтрации -->
        <Grid Grid.Row="1" Margin="36,0,36,22">
            <TextBox x:Name="SearchBox" Height="44" FontSize="15" Padding="14,0"
                     VerticalContentAlignment="Center"
                     Background="{DynamicResource PanelBrush}"
                     Foreground="{DynamicResource TextBrush}"
                     BorderBrush="{DynamicResource BorderBrush}"
                     TextChanged="SearchBox_TextChanged"
                     KeyDown="SearchBox_KeyDown"/>
            <TextBlock x:Name="SearchHint" Text="Search applications, projects, files..."
                       Foreground="{DynamicResource DimBrush}" FontSize="14"
                       Margin="16,0,0,0" VerticalAlignment="Center"
                       IsHitTestVisible="False"/>
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid MaxWidth="1780" HorizontalAlignment="Center" Margin="36,0,36,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.25*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ============ КОЛОНКА 1: конфиг + приложения ============ -->
                <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,36,0">
                    <StackPanel Style="{StaticResource SectionLabelStyle}">
                        <Rectangle Width="26" Height="3" Fill="{DynamicResource AccentBrush}"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Text="COLOR CONFIG" Foreground="{DynamicResource TextBrush}"
                                   FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding OcioChips}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Name}"
                                        Style="{StaticResource ChipButtonStyle}"
                                        Click="OcioChip_Click" Tag="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Style="{StaticResource SectionLabelStyle}" Margin="0,20,0,14">
                        <Rectangle Width="26" Height="3" Fill="{DynamicResource AccentBrush}"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock x:Name="AppsSection" Text="APPLICATIONS" Foreground="{DynamicResource TextBrush}"
                                   FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding AppTiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource TileButtonStyle}" Click="Tile_Click" Tag="{Binding}"
                                        Visibility="{Binding TileVisibility}">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{Binding Icon}" Width="44" Height="44"
                                               RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                                        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Subtitle}" FontSize="10.5"
                                                       Foreground="{DynamicResource DimBrush}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="AppsEmpty" Text="Nothing matches."
                               Foreground="{DynamicResource DimBrush}" FontSize="12" FontStyle="Italic"
                               Visibility="Collapsed"/>
                </StackPanel>

                <!-- ============ КОЛОНКА 2: проекты ============ -->
                <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,0,36,0">
                    <StackPanel Style="{StaticResource SectionLabelStyle}">
                        <Rectangle Width="26" Height="3" Fill="{DynamicResource AccentBrush}"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock x:Name="ProjectsSection" Text="PROJECTS" Foreground="{DynamicResource TextBrush}"
                                   FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>
                    <ItemsControl x:Name="RootsList" ItemsSource="{Binding RootChips}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Name}" ToolTip="{Binding Path}"
                                        Style="{StaticResource ChipButtonStyle}"
                                        Click="RootChip_Click" Tag="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl x:Name="ProjectFilesList" ItemsSource="{Binding ProjectFileTiles}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource RowButtonStyle}" Click="Tile_Click" Tag="{Binding}"
                                        ToolTip="{Binding FullPath}"
                                        Visibility="{Binding TileVisibility}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Badge}" FontSize="10.5"
                                                   FontFamily="Consolas" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,14,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12"
                                                   FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Dir}" FontSize="10.5"
                                                   Foreground="{DynamicResource DimBrush}"
                                                   VerticalAlignment="Center" Margin="24,0,0,0"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="ProjectsEmpty" Text="Add project roots in the launcher's Projects panel."
                               Foreground="{DynamicResource DimBrush}" FontSize="12" FontStyle="Italic"/>
                </StackPanel>

                <!-- ============ КОЛОНКА 3: профили + recent + роли ============ -->
                <StackPanel Grid.Column="2" Grid.Row="0">
                    <StackPanel Style="{StaticResource SectionLabelStyle}">
                        <Rectangle Width="26" Height="3" Fill="{DynamicResource AccentBrush}"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Text="PROFILES" Foreground="{DynamicResource TextBrush}"
                                   FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>
                    <ItemsControl x:Name="ProfilesList" ItemsSource="{Binding ProfileTiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource RowButtonStyle}" Click="Tile_Click" Tag="{Binding}"
                                        Visibility="{Binding TileVisibility}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="30" Height="30" CornerRadius="15"
                                                Background="{DynamicResource AccentBrush}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Monogram}" FontSize="14" FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentTextBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Subtitle}" FontSize="10"
                                                       Foreground="{DynamicResource DimBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="ProfilesEmpty" Text="No profiles yet — build one in the launcher's Profiles panel."
                               Foreground="{DynamicResource DimBrush}" FontSize="12" FontStyle="Italic"/>

                    <StackPanel Style="{StaticResource SectionLabelStyle}" Margin="0,22,0,14">
                        <Rectangle Width="26" Height="3" Fill="{DynamicResource AccentBrush}"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock x:Name="RecentSection" Text="RECENT FILES" Foreground="{DynamicResource TextBrush}"
                                   FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>
                    <ItemsControl x:Name="RecentList" ItemsSource="{Binding RecentTiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource RowButtonStyle}" Click="Tile_Click" Tag="{Binding}"
                                        ToolTip="{Binding FullPath}"
                                        Visibility="{Binding TileVisibility}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Badge}" FontSize="10.5"
                                                   FontFamily="Consolas" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,14,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12"
                                                   FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Dir}" FontSize="10.5"
                                                   Foreground="{DynamicResource DimBrush}"
                                                   VerticalAlignment="Center" Margin="24,0,0,0"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="RecentEmpty" Text="Opened files will appear here."
                               Foreground="{DynamicResource DimBrush}" FontSize="12" FontStyle="Italic"/>

                    <StackPanel Style="{StaticResource SectionLabelStyle}" Margin="0,22,0,14">
                        <Rectangle Width="26" Height="3" Fill="{DynamicResource AccentBrush}"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock x:Name="RolesSection" Text="OCIO ROLES" Foreground="{DynamicResource TextBrush}"
                                   FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>
                    <ItemsControl x:Name="RolesList" ItemsSource="{Binding RoleRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource RowButtonStyle}" Height="38" Click="RoleRow_Click" Tag="{Binding}"
                                        ToolTip="Click to override this role for the selected preset">
                                    <TextBlock Text="{Binding DisplayText}" FontSize="11" FontFamily="Consolas"
                                               TextTrimming="CharacterEllipsis"/>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Reset roles to config" Style="{StaticResource RowButtonStyle}" Height="34"
                            Command="{Binding ResetRolesCommand}"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Низ: аргументы + настройки -->
        <Border Grid.Row="3" Background="{DynamicResource PanelBrush}" Padding="36,14,36,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.6*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,36,0">
                    <TextBlock Text="ARGUMENTS" Foreground="{DynamicResource DimBrush}" FontSize="10.5"
                               FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding ArgsText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}" FontSize="12" Height="30" Padding="8,2"
                                 VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1" Content="Clear" Style="{StaticResource RowButtonStyle}"
                                Width="70" Height="30" Margin="8,0,0,0"
                                Command="{Binding ClearArgsCommand}"/>
                    </Grid>
                    <TextBlock Text="Arguments apply to launches from this overlay and the launcher."
                               Foreground="{DynamicResource DimBrush}" FontSize="10" Margin="0,6,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="SETTINGS" Foreground="{DynamicResource DimBrush}" FontSize="10.5"
                               FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Theme" Foreground="{DynamicResource DimBrush}"
                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}"
                                  Height="28" Background="{DynamicResource PanelBrush}"
                                  Foreground="{DynamicResource TextBrush}"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <CheckBox Content="Always on top" IsChecked="{Binding TopMostEnabled}"
                                  Foreground="{DynamicResource TextBrush}" FontSize="12" Margin="0,0,22,0"/>
                        <CheckBox Content="Overlay on top" IsChecked="{Binding OverlayTopmost}"
                                  Foreground="{DynamicResource TextBrush}" FontSize="12" Margin="0,0,22,0"/>
                        <CheckBox Content="Ctrl+Alt+F opens dashboard" IsChecked="{Binding HotkeyOpensDashboard}"
                                  Foreground="{DynamicResource TextBrush}" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
